<?xml version="1.0" encoding="UTF-8"?>
<martif type="TBX" xml:lang="en"><martifHeader><fileDesc><titleStmt><title>Glossary EN-RU: Юриспруденция: договорное и контрактное право</title></titleStmt><sourceDesc><p>Lab 01, variant 5</p></sourceDesc></fileDesc></martifHeader><text><body><termEntry id="tid-001"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>abate</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To put an end to, nullify, or reduce in amount, especially proportionately.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>положить конец; прекратить</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-002"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>abduction</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The criminal taking or capture of an individual against their will or without their consent, generally by means of persuasion, fraud, or force.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>преступление, заключающееся в уводе жены, ребенка или подопечного</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-003"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>abide by</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">To accept, comply with, or act in accordance with a law, agreement, or decision.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>действовать в соответствии (с чем-либо)</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-004"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>abrogate</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To formally annul, repeal, or abolish a law, custom, or contract through authoritative action.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>прекратить действие (закона); упразднять</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-005"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>abscond</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To leave a jurisdiction secretly or suddenly, especially to avoid arrest, prosecution, or legal process.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>скрываться; бежать из-под стражи</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-006"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>accessory</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who, though not present at the commission of a crime, contributes to or assists in its commission.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>пособник; соучастник</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-007"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>accomplice</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who knowingly, voluntarily, or intentionally assists another in the commission of a crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>соучастник; пособник</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-008"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>acquittal</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal and formal certification of the innocence of a person charged with a crime; a finding of not guilty.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>оправдание (по суду)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-009"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>actus reus</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The external, physical elements of a crime, including a voluntary act, omission, or state of affairs, as required by statute.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>виновное действие</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-010"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>admissible evidence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Evidence that is relevant, material, and not excluded by law, and may therefore be presented before the trier of fact.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>допустимое доказательство</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-011"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>adoption</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The legal process of establishing a parent-child relationship between persons not related by blood.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>усыновление, удочерение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-012"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>adversary system</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A legal system in which two opposing parties present their cases before a neutral court.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>состязательная система</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-013"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>affidavit</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A written statement of facts confirmed by the oath or affirmation of the party making it.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>аффидевит; нотариально заверенное заявление</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-014"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>affirmation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A solemn declaration made under penalty of perjury, in place of an oath, by a person who conscientiously objects to taking an oath.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>подтверждение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-015"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>aggravated assault</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">An unlawful attack by one person upon another for the purpose of inflicting severe or aggravated bodily injury, often with a deadly weapon.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>нападение при отягчающих обстоятельствах</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-016"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>alibi</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A defense asserting that the accused was somewhere other than the scene of the crime at the time it was committed.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>алиби</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-017"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>alimony</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Court-ordered financial support paid by one spouse to the other during or after divorce proceedings.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>алименты на содержание</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-018"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>allegation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A claim or assertion made without proof, especially in a legal pleading.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>голословное утверждение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-019"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>ambiguity</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The state of a document or statement having more than one possible meaning.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>двусмысленность (документа)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-020"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>amend</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To alter, modify, or change a document, especially a legal pleading or constitution.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>вносить поправку</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-021"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>annulment</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal decree declaring a marriage void, as if it never legally existed.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>признание брака недействительным</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-022"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>answer</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal written response by a defendant to a plaintiff's complaint, admitting or denying the allegations.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>возражения ответчика (по делу)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-023"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>appeal</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A proceeding by which a party seeks review by a higher court of a lower court's decision.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>апелляционная жалоба; обжалование</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-024"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>appellant</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The party who initiates an appeal to a higher court.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>апеллянт; истец по апелляции</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-025"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>appellee</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The party against whom an appeal is taken; the responding party in an appellate proceeding.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ответчик (в апелляционном суде)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-026"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>arbitration</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A process in which a neutral third party (arbitrator) resolves a dispute by rendering a binding decision.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>арбитражное разбирательство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-027"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>arraignment</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court proceeding in which a criminal defendant is brought before a judge to be formally charged and enter a plea.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>предъявление обвинения в суде</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-028"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>arrest warrant</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A court order directing law enforcement to arrest a specified person.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ордер на арест</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-029"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>arson</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The malicious and willful burning of a dwelling or other structure.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>умышленный поджог</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-030"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>assault</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An intentional act that creates a reasonable apprehension of imminent harmful or offensive contact.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>покушение на нанесение удара; угроза насилием</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-031"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>assignee</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person to whom a right or property is transferred.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>цессионарий; правопреемник</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-032"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>assignor</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who transfers a right or property to another.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>цедент; лицо, передающее право</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-033"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>attachment</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal process by which a court seizes property to satisfy a judgment or secure jurisdiction.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>наложение ареста на имущество</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-034"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>bail</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Security given for the release of a criminal defendant from custody, ensuring their appearance at trial.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>залог; поручительство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-035"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>bankruptcy</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal proceeding for a person or business that cannot repay debts to creditors.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>банкротство; несостоятельность</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-036"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>battery</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The intentional use of force or violence upon another person without consent.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>избиение; незаконное применение силы</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-037"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>bench trial</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A trial in which a judge, rather than a jury, decides all issues of fact and law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>суд без участия жюри</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-038"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>bench warrant</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A warrant issued by a judge for the arrest of a person who has failed to appear in court or comply with a court order.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ордер на арест, выданный судьей</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-039"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>beneficiary</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who receives benefits from a trust, will, or insurance policy.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>бенефициар; выгодоприобретатель</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-040"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>bequest</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A gift of personal property made in a will.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>завещанное наследство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-041"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>beyond a reasonable doubt</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The standard of proof required in criminal cases, requiring the jury to be fully convinced of the defendant's guilt.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>вне всякого сомнения</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-042"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>bifurcation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The division of a trial into separate phases, such as guilt and punishment.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>раздвоение; раздельное рассмотрение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-043"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>bill of indictment</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A formal written accusation charging a person with a crime, presented to a grand jury.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>обвинительное заключение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-044"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>binding agreement</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A contract or agreement that is legally enforceable.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>юридически обязывающее соглашение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-045"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>blackmail</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The demand for money or other benefit by threat of revealing damaging information.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>шантаж; вымогательство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-046"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>breach of contract</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The failure to perform any term of a contract without a legitimate legal excuse.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>нарушение договора</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-047"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>bribery</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The offering, giving, receiving, or soliciting of something of value to influence official action.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>взяточничество; подкуп</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-048"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>burden of proof</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The obligation to prove allegations in a legal proceeding.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>бремя доказывания</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-049"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>burglary</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The unlawful entry into a building with the intent to commit a felony or theft.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>кража со взломом</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-050"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>capital crime</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A crime for which the punishment may be death.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>преступление, наказуемое смертной казнью</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-051"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>carjacking</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The forcible theft of a motor vehicle from its driver.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>угон автомобиля с применением силы</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-052"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>case law</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Law established by previous court decisions rather than by statutes.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>прецедентное право</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-053"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>caveat emptor</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A principle that the buyer alone is responsible for checking the quality and suitability of goods before a purchase.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>пусть покупатель будет осторожен</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-054"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>cease and desist order</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">An order issued by a court or agency to stop an illegal or harmful activity.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>приказ о прекращении действий</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-055"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>certiorari</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A writ by which a higher court reviews the record of a lower court.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>апеллирование в Верховный Суд США</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-056"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>chain of custody</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The documented sequence of persons who had custody of evidence to ensure its integrity.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>метод прослеживания доказательства</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-057"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>challenge</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An objection to the seating of a juror, either for cause or peremptorily.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>отвод (присяжного)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-058"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>charge</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal accusation of a crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>обвинение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-059"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>chattel</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An article of personal property.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>движимое имущество</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-060"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>check</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A restraint or control, as in checks and balances.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>сдержка; контроль</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-061"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>circumstantial evidence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Evidence that indirectly proves a fact by inference, rather than directly.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>косвенные доказательства</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-062"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>citation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court order to appear, or a reference to a legal authority.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>распоряжение суда о предъявлении обвинений</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-063"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>civil action</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A lawsuit brought to enforce, redress, or protect private rights.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>гражданский иск</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-064"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>claim</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A demand for a legal remedy or right.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>иск; претензия</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-065"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>class action</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A lawsuit filed by one or more persons on behalf of a larger group with common interests.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>групповой иск</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-066"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>clean hands</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A legal doctrine that a party seeking equitable relief must not have acted unethically.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>чистые руки</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-067"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>clear and convincing evidence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A standard of proof higher than preponderance of the evidence but lower than beyond a reasonable doubt.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>явное и убедительное доказательство</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-068"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>clerical error</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A minor mistake in a legal document, often correctable by the court.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>канцелярская опечатка</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-069"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>codicil</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A supplement or addition to a will that modifies or revokes provisions.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>дополнение к завещанию</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-070"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>coercion</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The use of force or threats to compel someone to act against their will.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>принуждение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-071"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>collateral</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Property pledged as security for a debt.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>залоговое обеспечение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-072"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>common law</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Law derived from judicial decisions and custom, rather than from statutes.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>общее право</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-073"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>community property</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Property acquired during marriage that is owned jointly by both spouses.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>совместная собственность супругов</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-074"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>commutation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The reduction of a criminal sentence to a less severe one.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>изменение приговора</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-075"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>complainant</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The party who initiates a legal complaint.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>истец; заявитель</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-076"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>complaint</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The initial pleading by a plaintiff setting out the claims against a defendant.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>исковое заявление</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-077"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>concurrent sentences</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Sentences for multiple crimes that are served at the same time.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>совпадающие приговоры</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-078"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>concurring opinion</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A separate opinion by a judge who agrees with the majority's decision but for different reasons.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>совпадающее мнение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-079"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>condemnation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The legal process by which the government takes private property for public use with just compensation.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>законное отчуждение собственности</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-080"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>confession</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A statement by a person acknowledging their guilt in a crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>признание</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-081"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>conflict of interest</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A situation where a person's personal interests conflict with their professional or public duties.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>конфликт интересов</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-082"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>consent</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Voluntary agreement to an act or proposal.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>согласие</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-083"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>consecutive sentences</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Sentences for multiple crimes that are served one after the other.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>последовательные приговоры</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-084"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>conservator</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person appointed by a court to manage the affairs of an incapacitated individual.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>опекун; попечитель</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-085"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>constitutional right</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A right guaranteed by a constitution.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>конституционное право</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-086"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>constructive possession</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Control over property without actual physical possession.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>подразумеваемое владение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-087"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>contempt of court</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Disobedience or disrespect toward a court, punishable by fine or imprisonment.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>неуважение к суду</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-088"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>contingency fee</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A fee paid to a lawyer only if the case is won, usually a percentage of the recovery.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>гонорар по результату</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-089"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>contract</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legally binding agreement between two or more parties.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>договор</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-090"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>contributory negligence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A defense that reduces a plaintiff's recovery if they contributed to their own injury.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>встречная небрежность</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-091"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>conversion</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The unauthorized taking or use of another's property.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>незаконное присвоение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-092"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>conviction</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal declaration that someone is guilty of a criminal offense.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>осуждение; обвинительный приговор</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-093"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>copyright</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The exclusive legal right to reproduce, publish, and sell a literary, musical, or artistic work.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>авторское право</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-094"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>corroborating evidence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Evidence that strengthens or confirms other evidence.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>подтверждающее доказательство</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-095"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>counsel</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A lawyer or legal advisor.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>адвокат; юрисконсульт</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-096"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>counterclaim</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A claim brought by a defendant against the plaintiff in the same lawsuit.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>встречный иск</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-097"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>court of appeals</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">An intermediate appellate court that reviews decisions of lower courts.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>апелляционный суд</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-098"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>covenant</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal agreement or promise, often under seal.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>договор; обязательство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-099"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>credibility</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The quality of being believable or trustworthy, especially of a witness.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>достоверность</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-100"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>crime</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An act or omission prohibited by law and punishable by the state.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>преступление</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-101"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>criminal intent</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The mental state required for a person to be guilty of a crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>преступный умысел</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-102"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>cross-examination</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The questioning of a witness by the opposing party to test the truth of their testimony.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>перекрестный допрос</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-103"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>custody</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The care and control of a person or property; also, legal confinement.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>опека; содержание под стражей</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-104"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>damages</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Monetary compensation awarded to a party for loss or injury caused by another.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>возмещение ущерба; убытки</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-105"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>de facto</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">In fact or in practice, whether or not legally recognized.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>де-факто; фактически</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-106"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>deadly weapon</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Any object or instrument likely to cause death or serious bodily injury.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>смертоносное оружие</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-107"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>death penalty</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The punishment of execution for a capital crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>смертная казнь</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-108"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>debtor</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person or entity that owes money to another.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>должник</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-109"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>decree</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court order or judgment.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебное решение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-110"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>deed</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A written instrument that transfers title to real property.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>договор за печатью</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-111"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>defamation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The publication of a false statement that harms another's reputation.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>диффамация; клевета</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-112"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>default judgment</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A judgment entered against a party who fails to appear or respond in a lawsuit.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>заочное решение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-113"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>defendant</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The party against whom a lawsuit or criminal charge is brought.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ответчик; подсудимый</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-114"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>defense attorney</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A lawyer who represents a defendant in a criminal or civil case.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>адвокат защиты</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-115"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>deficiency</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A shortage or lack, especially of money owed.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>задолженность; недостача</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-116"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>defraud</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To deprive someone of property or a right by deception.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>обманывать; мошенничать</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-117"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>deposition</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Sworn testimony given out of court and recorded in writing for use in litigation.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>свидетельские показания под присягой</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-118"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>deterrence</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The use of punishment to discourage future criminal behavior.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>сдерживание</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-119"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>direct evidence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Evidence that directly proves a fact without inference.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>прямое доказательство</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-120"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>direct examination</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The first questioning of a witness by the party who called them.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>первоначальный допрос</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-121"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>discovery</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The pretrial process by which parties exchange information and evidence.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>раскрытие доказательств</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-122"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>dissent</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A disagreement with the majority opinion in a court decision.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>особое мнение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-123"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>divorce</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The legal dissolution of a marriage.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>развод; расторжение брака</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-124"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>docket</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court's calendar of scheduled cases.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>список судебных дел</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-125"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>doctrine</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal principle or rule established through judicial decisions or scholarly writing.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>доктрина; принцип</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-126"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>domicile</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person's permanent legal residence.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>постоянное место жительства</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-127"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>double jeopardy</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The constitutional protection against being tried twice for the same offense.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>повторное привлечение к ответственности</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-128"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>due process</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The fair treatment through the judicial system, including notice and an opportunity to be heard.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>надлежащая правовая процедура</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-129"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>duress</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Unlawful pressure that compels a person to act against their will.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>принуждение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-130"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>easement</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal right to use another's land for a specific purpose.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>сервитут; право пользования чужой собственностью</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-131"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>embezzlement</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The fraudulent appropriation of property by a person to whom it was entrusted.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>присвоение или растрата имущества</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-132"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>eminent domain</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The government's power to take private property for public use with just compensation.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>право государства на принудительное отчуждение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-133"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>en banc</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The hearing of a case by all judges of an appellate court, rather than a panel.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>всем составом суда</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-134"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>enjoin</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To order a person to do or refrain from doing a specific act.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>запретить; вменить в обязанность</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-135"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>entrapment</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A defense that law enforcement induced a person to commit a crime they would not otherwise have committed.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>провокация преступления</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-136"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>equity</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A system of law based on fairness and justice, supplementing common law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>право справедливости</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-137"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>escrow</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Money or documents held by a neutral third party until a condition is met.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>условное депонирование</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-138"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>estate</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">All property owned by a person at death, subject to probate.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>наследственное имущество</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-139"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>estoppel</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal principle preventing a person from contradicting a previous statement or act.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>лишение права противоречить</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-140"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>evidence</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Any matter presented to the court to prove or disprove a fact.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>доказательство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-141"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>ex parte</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A proceeding brought by one party without notice to or presence of the other.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>в одностороннем порядке</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-142"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>exclusionary rule</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A rule that evidence obtained in violation of the Constitution is inadmissible.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>правило об исключении доказательств</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-143"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>exclusive jurisdiction</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The power of a court to hear a case to the exclusion of all other courts.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>исключительная подсудность</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-144"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>exculpatory evidence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Evidence that tends to clear a defendant from guilt.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>оправдательное доказательство</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-145"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>executor</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person named in a will to administer the estate of the deceased.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>душеприказчик</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-146"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>exemplary damages</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Damages awarded to punish the defendant and deter similar conduct.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>штрафные убытки</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-147"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>expert witness</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A witness qualified by knowledge or experience to testify on a specialized subject.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>свидетель-эксперт</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-148"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>extradition</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The formal process by which one state surrenders a person accused of a crime to another state.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>выдача преступника</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-149"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>felony</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A serious crime, typically punishable by imprisonment for more than one year.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>уголовное преступление; фелония</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-150"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>fiduciary</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who acts on behalf of another in a relationship of trust and confidence.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>доверенное лицо; фидуциар</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-151"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>filing</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The act of submitting a document to a court for inclusion in the record.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>подача документов в суд</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-152"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>fine</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A monetary penalty imposed for a violation of law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>штраф</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-153"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>firearm</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A weapon capable of firing a projectile by the action of an explosive.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>огнестрельное оружие</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-154"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>foreclosure</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The legal process by which a lender takes possession of a property after the borrower defaults.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>обращение взыскания на заложенное имущество</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-155"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>forgery</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The fraudulent making or alteration of a written document.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>подделка документа</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-156"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>fraud</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Intentional deception to secure unfair or unlawful gain.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>мошенничество</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-157"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>garnishment</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal process by which a portion of a person's wages is withheld to pay a debt.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>удержание из заработной платы</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-158"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>grand jury</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A jury that determines whether there is sufficient evidence to charge a person with a crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>большое жюри</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-159"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>grievance</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal complaint about a violation of rights or entitlements.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>жалоба</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-160"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>guilty plea</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A defendant's formal admission in court that they committed the crime charged.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>признание вины</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-161"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>habeas corpus</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A writ requiring a person under arrest to be brought before a judge to determine the legality of their detention.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебный приказ о доставлении лица в суд</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-162"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>hearsay</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An out-of-court statement offered to prove the truth of the matter asserted, generally inadmissible.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>показания с чужих слов</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-163"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>homicide</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The killing of one human being by another.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>убийство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-164"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>hostile witness</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A witness whose testimony is adverse to the party who called them.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>свидетель, дающий показания против вызвавшей стороны</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-165"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>immunity</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Exemption from legal liability or prosecution.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>иммунитет</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-166"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>impeachment</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The process of charging a public official with misconduct in office.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>импичмент</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-167"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>implied contract</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A contract inferred from the conduct of the parties rather than express words.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>подразумеваемый договор</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-168"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>in camera</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A private hearing held in the judge's chambers, without the public or jury.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>в закрытом судебном заседании</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-169"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>incarceration</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Imprisonment.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>тюремное заключение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-170"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>indictment</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal written accusation of a crime, issued by a grand jury.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>обвинительное заключение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-171"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>injunction</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court order requiring a party to do or refrain from doing a specific act.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебный запрет</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-172"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>inquest</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A judicial inquiry, especially into a death.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>дознание</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-173"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>interrogatories</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Written questions submitted by one party to another as part of discovery.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>письменные вопросы для допроса</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-174"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>intestate</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who dies without a valid will.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>умерший без завещания</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-175"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>irreparable harm</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Injury that cannot be adequately compensated by money damages.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>непоправимый вред</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-176"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>jeopardy</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The risk of conviction in a criminal proceeding.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>опасность судебного преследования</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-177"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>judgment</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court's final determination of the rights and claims of the parties.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебное решение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-178"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>judicial review</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The power of courts to review and invalidate laws or acts of government that violate the constitution.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебный надзор</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-179"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>jurisdiction</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The authority of a court to hear and decide a case.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>юрисдикция; подсудность</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-180"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>jurisprudence</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The theory or philosophy of law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>юриспруденция</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-181"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>juvenile court</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A court that deals with offenses committed by minors.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>суд по делам несовершеннолетних</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-182"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>kidnapping</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The unlawful taking and carrying away of a person by force or fraud.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>похищение человека</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-183"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>larceny</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The unlawful taking and carrying away of personal property with intent to permanently deprive the owner.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>кража; хищение чужого имущества</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-184"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>lawsuit</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal proceeding in a civil court.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>гражданский иск</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-185"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>leading question</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A question that suggests the answer desired by the examiner.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>наводящий вопрос</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-186"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>lease</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A contract granting possession and use of property for a specified period in exchange for rent.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>договор аренды</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-187"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>legal aid</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Government-funded legal assistance for those who cannot afford a lawyer.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>бесплатная юридическая помощь</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-188"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>legal capacity</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A person's legal ability to enter into contracts and sue or be sued.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>правоспособность</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-189"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>legislation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The process of making laws; also, the laws themselves.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>законодательство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-190"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>legislature</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A body of persons empowered to make laws.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>законодательный орган</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-191"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>libel</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A defamatory statement published in writing or other permanent form.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>клевета в письменной форме</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-192"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>lien</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal right to hold another's property as security for a debt.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>залоговое право</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-193"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>limitation of actions</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A statute setting the maximum time after an event within which legal proceedings may be initiated.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>срок исковой давности</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-194"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>litigation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The process of taking legal action; a lawsuit.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебный процесс; тяжба</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-195"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>magistrate</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A civil officer who administers the law, especially one who conducts preliminary hearings.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>магистрат; мировой судья</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-196"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>maintenance</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Financial support paid by one spouse to another, or for a child.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>алименты; содержание</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-197"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>malice aforethought</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The mental state required for murder, showing intent to kill or cause grievous harm.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>заранее обдуманный злой умысел</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-198"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>manslaughter</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The unlawful killing of a human being without malice aforethought.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>непредумышленное убийство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-199"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>material evidence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Evidence that is relevant and has a tendency to influence the outcome of a case.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>существенное доказательство</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-200"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>mediation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A process in which a neutral third party helps disputing parties reach a settlement.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>медиация</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-201"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>mens rea</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The mental element of a crime; the guilty mind.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>виновная воля; вина</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-202"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>misdemeanor</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A minor crime punishable by fine or imprisonment for less than one year.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>проступок; мисдиминор</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-203"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>mistrial</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A trial that is terminated before a verdict due to a fundamental error or deadlocked jury.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>аннуляция судебного процесса</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-204"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>mitigating circumstances</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Facts that may reduce the severity of a punishment but do not excuse the crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>смягчающие обстоятельства</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-205"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>moot</term><termNote type="partOfSpeech">adjective</termNote><descrip type="definition">Subject to debate; also, a point that is no longer relevant to a case.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>спорный; не имеющий практического значения</term><termNote type="partOfSpeech">adjective</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-206"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>moral turpitude</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Conduct that is contrary to community standards of justice, honesty, or good morals.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>безнравственность</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-207"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>mortgage</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A loan secured by real property.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ипотека</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-208"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>motion</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal request to a court for a ruling or order.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ходатайство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-209"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>murder</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The unlawful killing of a human being with malice aforethought.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>умышленное убийство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-210"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>negligence</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Failure to exercise the care that a reasonably prudent person would exercise.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>небрежность</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-211"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>negotiable instrument</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A written document signed by the maker, promising to pay a sum of money.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>оборотный документ</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-212"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>no-fault</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A legal system in which fault is not considered, as in no-fault divorce or insurance.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>без вины</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-213"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>notary public</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A public officer authorized to administer oaths and certify documents.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>нотариус</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-214"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>nuisance</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An unreasonable interference with the use and enjoyment of property.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>источник вреда; нарушение покоя</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-215"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>oath</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A solemn promise to tell the truth, often invoking a divine witness.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>присяга</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-216"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>objection</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal protest to the admission of evidence or a question.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>возражение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-217"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>offense</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A violation of law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>правонарушение; преступление</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-218"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>offer</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A proposal to enter into a contract.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>оферта; предложение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-219"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>opening statement</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A statement by counsel at the beginning of a trial outlining the facts they intend to prove.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>вступительная речь</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-220"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>opinion</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The written explanation of a court's decision.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>мнение суда</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-221"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>ordinance</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A law enacted by a local government.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>постановление местного органа власти</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-222"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>overt act</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">An open act showing an intent to commit a crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>явное действие</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-223"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>pardon</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An act of grace by a governor or president releasing a convicted person from punishment.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>помилование</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-224"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>parole</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The release of a prisoner before the expiration of their sentence under supervision.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>условно-досрочное освобождение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-225"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>party</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person or entity involved in a legal proceeding.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>сторона (в судебном процессе)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-226"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>penalty</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A punishment imposed for a violation of law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>наказание; санкция</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-227"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>per curiam</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">An opinion issued by an appellate court as a whole, without attributing authorship.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>решением суда</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-228"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>peremptory challenge</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The right to reject a potential juror without stating a reason.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>немотивированный отвод</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-229"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>perjury</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The crime of intentionally lying under oath.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>лжесвидетельство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-230"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>petition</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal written request to a court.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>исковое заявление; петиция</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-231"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>plaintiff</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The party who initiates a lawsuit.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>истец</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-232"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>plea bargain</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">An agreement between the prosecutor and defendant in which the defendant pleads guilty to a lesser charge.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>сделка о признании вины</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-233"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>plea</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A defendant's formal answer to a criminal charge.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>заявление (в суде)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-234"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>pleadings</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Formal written statements of the parties' claims and defenses.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>состязательные бумаги</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-235"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>police power</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The inherent authority of a government to regulate for the health, safety, and welfare of the public.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>полицейская власть</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-236"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>precedent</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A prior court decision that serves as a rule for future similar cases.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>прецедент</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-237"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>preliminary hearing</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A hearing to determine if there is sufficient evidence to hold a defendant for trial.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>предварительное слушание</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-238"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>preliminary injunction</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A court order issued before a trial to prevent harm until the case is decided.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>предварительный судебный запрет</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-239"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>premeditation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The act of planning or deliberating a crime before committing it.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>предварительное обдумывание</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-240"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>preponderance of the evidence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The standard of proof in civil cases, meaning the evidence is more likely true than not.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>перевес доказательств</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-241"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>presumption of innocence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The principle that a defendant is considered innocent until proven guilty.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>презумпция невиновности</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-242"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>pre-trial conference</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A meeting between parties and the judge before trial to narrow issues and discuss settlement.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>предварительное судебное совещание</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-243"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>prima facie</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Evidence that is sufficient on its face to prove a fact unless rebutted.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>на первый взгляд; при отсутствии опровержения</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-244"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>probable cause</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Reasonable grounds to believe a crime has been committed, justifying arrest or search.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>достаточное основание</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-245"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>probate</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The judicial process of validating a will and administering an estate.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>утверждение завещания</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-246"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>probation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A sentence allowing a convicted person to remain in the community under supervision.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>условное осуждение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-247"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>procedural law</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The rules governing the conduct of legal proceedings.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>процессуальное право</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-248"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>prosecutor</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The public official who conducts criminal prosecutions.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>прокурор; обвинитель</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-249"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>proximate cause</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The primary cause of an injury; a cause that is legally sufficient to result in liability.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>непосредственная причина</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-250"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>punitive damages</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Damages awarded to punish the defendant for egregious conduct.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>штрафные убытки</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-251"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>quash</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To nullify or set aside a legal proceeding or indictment.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>отменять; аннулировать</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-252"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>quid pro quo</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Something given or received in exchange for something else.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>услуга за услугу</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-253"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>quo warranto</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A writ requiring a person to show by what authority they hold an office or franchise.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебный приказ о производстве</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-254"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>rape</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Unlawful sexual intercourse by force or threat of force.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>изнасилование</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-255"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>reasonable doubt</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The doubt that prevents one from being firmly convinced of a defendant's guilt.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>разумное сомнение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-256"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>rebuttal</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Evidence presented to contradict or overcome other evidence.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>опровержение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-257"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>recidivism</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The tendency of a convicted criminal to reoffend.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>рецидив</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-258"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>reckless driving</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">Driving with a willful or wanton disregard for the safety of persons or property.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>небрежное вождение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-259"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>recognizance</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A bond by which a person undertakes before a court to do or refrain from doing something.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>обязательство, данное в суде</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-260"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>redirect examination</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The questioning of a witness by the party who called them, after cross-examination.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>повторный допрос</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-261"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>recusal</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The act of a judge withdrawing from a case due to a conflict of interest.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>отвод (судьи)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-262"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>remedy</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The means by which a legal right is enforced or a wrong is redressed.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>средство судебной защиты</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-263"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>restitution</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The restoration of property to its rightful owner; also, compensation for loss.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>восстановление первоначального правового положения</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-264"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>restraining order</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A court order that prohibits a person from doing a specific act, often for protection.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>запретительный судебный приказ</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-265"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>retainer</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The act of engaging a lawyer; also, the fee paid to secure legal services.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>соглашение с адвокатом</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-266"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>reverse</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To set aside or annul a lower court's judgment.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>отменять (судебное решение)</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-267"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>revocation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The act of cancelling or annulling something, such as a will or license.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>отмена; аннулирование</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-268"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>robbery</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The taking of property from a person by force or threat of force.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>грабеж; разбой</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-269"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>rule of law</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The principle that all persons and institutions are subject to and accountable under the law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>верховенство права</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-270"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>sanction</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A penalty or coercive measure imposed for a violation of law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>санкция</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-271"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>search warrant</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A court order authorizing law enforcement to search a specific place for evidence.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ордер на обыск</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-272"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>seizure</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The taking of property by legal authority.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>выемка; изъятие</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-273"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>self-incrimination</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The act of exposing oneself to criminal prosecution by giving testimony.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>самоизобличение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-274"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>sentence</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The punishment imposed by a court on a convicted defendant.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>приговор</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-275"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>sequestration</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The isolation of a jury to prevent outside influence.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>изоляция присяжных</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-276"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>settlement</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An agreement resolving a dispute without a trial.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>мировое соглашение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-277"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>slander</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A defamatory statement spoken aloud.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>клевета в устной форме</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-278"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>small claims court</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A court that handles civil cases involving small amounts of money.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>суд по делам с небольшой суммой иска</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-279"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>solicitation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The act of encouraging or requesting another to commit a crime.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>подстрекательство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-280"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>specific performance</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A remedy requiring a party to perform a contract as agreed.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>реальное исполнение</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-281"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>standing</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The legal right to bring a lawsuit.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>право на иск</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-282"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>stare decisis</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The principle that courts should follow precedent.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>доктрина судебного прецедента</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-283"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>statute</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A law enacted by a legislative body.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>статут; закон</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-284"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>statute of limitations</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A law setting the time limit for filing a lawsuit.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>срок исковой давности</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-285"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>stay</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court order halting a proceeding.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>приостановление производства</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-286"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>stipulation</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">An agreement between opposing parties about a fact or issue in a case.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>соглашение сторон</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-287"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>subpoena</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court order requiring a person to appear as a witness or produce documents.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>повестка в суд</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-288"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>summary judgment</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A judgment entered without a full trial when there is no genuine dispute of material fact.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебное решение без судебного разбирательства</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-289"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>summons</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A document informing a defendant of a lawsuit and requiring a response.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебная повестка</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-290"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>suppress</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To prevent evidence from being used at trial.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>пресекать; запретить</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-291"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>surety</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who takes responsibility for another's debt or obligation.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>поручитель</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-292"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>suspended sentence</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A sentence that is not served if the defendant meets certain conditions.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>условный приговор</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-293"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>testimony</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">Evidence given by a witness under oath.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>свидетельские показания</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-294"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>tort</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A civil wrong that causes a claimant to suffer loss or harm.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>деликт; гражданское правонарушение</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-295"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>tortfeasor</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who commits a tort.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>правонарушитель; причинитель вреда</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-296"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>transcript</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The official written record of a court proceeding.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>протокол судебного заседания</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-297"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>trespass</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The unlawful entry onto another's land.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>нарушение чужого права владения</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-298"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>trial</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal examination of evidence before a court to determine guilt or liability.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебное разбирательство</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-299"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>trust</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal arrangement in which one person holds property for the benefit of another.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>доверительная собственность; траст</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-300"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>trustee</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who holds property in trust for another.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>доверительный собственник</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-301"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>unconstitutional</term><termNote type="partOfSpeech">adjective</termNote><descrip type="definition">Not in accordance with the constitution.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>неконституционный</term><termNote type="partOfSpeech">adjective</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-302"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>unlawful</term><termNote type="partOfSpeech">adjective</termNote><descrip type="definition">Not authorized by law; illegal.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>противозаконный</term><termNote type="partOfSpeech">adjective</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-303"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>usury</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The practice of charging interest rates that are illegally high.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>взимание процентов выше разрешенного законом</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-304"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>venue</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The geographic location where a case is tried.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>место рассмотрения дела</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-305"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>verdict</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The decision of a jury on the factual issues of a case.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>вердикт</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-306"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>void</term><termNote type="partOfSpeech">adjective</termNote><descrip type="definition">Having no legal force or effect.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ничтожный; не имеющий юридической силы</term><termNote type="partOfSpeech">adjective</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-307"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>voir dire</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The questioning of potential jurors to determine their suitability.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>предварительная проверка присяжных</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-308"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>waiver</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">The intentional relinquishment of a known right.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>отказ (от права)</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-309"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>warrant</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A court order authorizing law enforcement to make an arrest or conduct a search.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>ордер</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-310"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>will</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A legal document declaring how a person's property is to be distributed after death.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>завещание</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-311"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>with prejudice</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A dismissal of a case that prevents the plaintiff from filing the same claim again.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>с ущербом для права</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-312"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>witness</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A person who gives testimony in a legal proceeding.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>свидетель</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-313"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>writ</term><termNote type="partOfSpeech">noun</termNote><descrip type="definition">A formal written order issued by a court.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>судебный приказ</term><termNote type="partOfSpeech">noun</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-314"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>wrongful termination</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">The illegal dismissal of an employee in violation of contract or law.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>неправомерное прекращение обязательств</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-315"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>yield</term><termNote type="partOfSpeech">verb</termNote><descrip type="definition">To give way to a superior claim or right.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>уступать; соглашаться</term><termNote type="partOfSpeech">verb</termNote></termGrp></ntig></langSet></termEntry><termEntry id="tid-316"><descrip type="subjectField">Юриспруденция: договорное и контрактное право</descrip><langSet xml:lang="en"><tig><term>zero tolerance</term><termNote type="partOfSpeech">phrase</termNote><descrip type="definition">A policy of punishing all violations, no matter how minor.</descrip></tig></langSet><langSet xml:lang="ru"><ntig><termGrp><term>абсолютная недопустимость</term><termNote type="partOfSpeech">phrase</termNote></termGrp></ntig></langSet></termEntry></body></text></martif>